# ============================================================
# قَبَس (Qabas) — مفاتيح واجهات الذكاء الاصطناعي والوسائط
# كل الخدمات أدناه لها طبقات مجانية. املأ ما تريد فقط —
# التطبيق يعمل بدون مفتاح (التحليل المحلي + TTS النظام مجانيان).
# لإدخال المفاتيح داخل التطبيق: شاشة "مفاتيح API" في الإعدادات.
# ملاحظة: كل مفاتيح الخدمات يجب أن تحمل قيمة placeholder غير فارغة
# حتى يبقى ملف BuildConfig المولّد سليماً. املأ القيمة الحقيقية قبل البناء.
# ============================================================

# Google AI Studio (Gemini) — مجاني 15 RPM / ~1M رمز يومياً
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your_key"

# Azure Speech (توليد صوت عربي فصيح) — طبقة مجانية بحدود شهرية
# https://portal.azure.com → Speech Services
AZURE_SPEECH_KEY="your_key"
AZURE_SPEECH_REGION="your_region"

# ElevenLabs (أصوات سينمائية) — طبقة مجانية محدودة
# https://elevenlabs.io
ELEVENLABS_API_KEY="your_key"

# Groq (نموذج حر سريع للتعليق والسيناريو) — مجاني 30 RPM
# https://console.groq.com/keys
GROQ_API_KEY="your_key"

# OpenAI (نماذج GPT للتوليد المتقدم والسكريبتات) — مدفوع لكنه قوي
# https://platform.openai.com/api-keys
OPENAI_API_KEY="your_key"

# OpenRouter (بوابة نماذج مجانية حقيقية :free لخطط الطلبات) — مجاني
# https://openrouter.ai/keys
OPENROUTER_API_KEY="your_key"

# Hugging Face (توليد صور) — مجاني بالتجربة
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="your_key"

# Pexels (مقاطع وصور B-Roll) — مجاني لصنّاع المحتوى
# https://www.pexels.com/api/
PEXELS_API_KEY="your_key"

# Pixabay (مقاطع وصور B-Roll) — مجاني
# https://pixabay.com/api/docs/
PIXABAY_API_KEY="your_key"

# Coverr (مقاطع سينمائية 16:9 — اختياري، مجاني 50 طلب/ساعة)
# https://coverr.co/developers
COVERR_API_KEY="your_key"

# ------------------------------------------------------------
# Supabase (Backend-as-a-Service): Postgres + Auth + Storage + Edge Functions
# مجاني (Free Tier) — احصل عليه من لوحة تحكم Supabase: Project Settings → API
# ------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your_publishable_or_anon_key"

# ------------------------------------------------------------
# Quran Foundation (تلاوة صفحات المصحف — المشعّر Alafasy)
# https://dev-console.quran.foundation — مجاني، ويسمح بالاستخدام التجاري
# داخل التطبيق (ممنوع إعادة بيع البيانات). المفاتيح الحقيقية في `.env`
# المحلي (مستثنى من git) أو GitHub Secrets — لا تُحفظ في الكود أبداً.
# ملاحظة: نوع "Backend app" سرّه للسيرفر؛ الأفضل لاحقاً تطبيق "mobile" بلا secret.
# ------------------------------------------------------------
QF_CLIENT_ID="your_key"
QF_CLIENT_SECRET="your_key"

# ------------------------------------------------------------
# ملاحظة مجانية: إذا تركت جميع المفاتيح بقيم placeholder، لا يزال بإمكانك:
#   • تحليل الفكرة عبر المحلل المحلي المدمج (معاينة النبرة والمشاهد)
#   • توليد تعليق صوتي عبر محرك نطق أندرويد المدمج (لا يحتاج إنترنت)
#   • تصدير الفيديو بالكامل عبر محرك FFmpeg المحلي
# ------------------------------------------------------------
